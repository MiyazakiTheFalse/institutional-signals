{
  "name": "institutional-signals-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "institutional-signals-evidence" }],
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false }
}
