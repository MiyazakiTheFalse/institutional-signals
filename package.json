{
  "name": "institutional-signals",
  "private": true,
  "version": "0.2.0",
  "main": "desktop/main.cjs",
  "description": "Evidence-backed institutional research desktop application",
  "author": "Institutional Signals",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:package": "npm run build && electron-builder --config electron-builder.cjs --publish never",
    "test:desktop": "node --test desktop/test-validation.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "csv-parse": "6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~7.0.2",
    "vite": "^7.2.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  }
}
